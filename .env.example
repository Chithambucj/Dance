# ==============================================================================
# StepUp Dance Studio - Environment Configuration Template
# For Render deployment, configure these variables in the Render Dashboard Environment tab.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database Connection (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Iron Session Encryption Key (MUST be at least 32 characters long for cookie security)
SESSION_SECRET=your-random-32-char-secret-string-here

# Razorpay Payment Gateway (Production / Test keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Supabase Storage (Optional - falls back to local /public/uploads/ if omitted)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
